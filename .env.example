# CoinEx API Credentials
COINEX_ACCESS_ID=your_access_id_here
COINEX_SECRET_KEY=your_secret_key_here

# Trading Configuration
TRADING_MODE=TEST  # TEST for first 5 days, then NORMAL
TEST_MODE_START_DATE=2024-01-20T00:00:00  # ISO format

# Database
DATABASE_PATH=./storage/bot_state.db

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
SHOW_DEBUG_INFO=False

# Telegram Notifications (Optional - Low Priority)
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id