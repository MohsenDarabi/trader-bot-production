# CoinEx API Credentials
# Note: COINEX_API_KEY should contain your CoinEx "Access ID" value
# Note: COINEX_API_SECRET should contain your CoinEx "Secret Key" value
COINEX_API_KEY=your_access_id_here
COINEX_API_SECRET=your_secret_key_here

# Trading Configuration
TRADING_MODE=TEST  # TEST for first 5 days, then NORMAL
TEST_MODE_START_DATE=2024-01-20T00:00:00  # ISO format

# Database
DATABASE_PATH=./storage/bot_state.db

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
SHOW_DEBUG_INFO=False

# Order Status Checks (Advanced)
# How often to perform REST API status checks in seconds (default: 300 = 5 minutes)
# Set to -1 to disable REST API checks completely (rely on WebSocket only)
# Lower values = more API calls but faster detection of issues
# Higher values = fewer API calls but relies more on WebSocket
ORDER_STATUS_CHECK_INTERVAL=300

# Telegram Notifications (Optional - Low Priority)
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id