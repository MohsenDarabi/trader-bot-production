# AAVE Trading Bot Environment Configuration
# Using same CoinEx account as ETH bot (377EB9...)
COINEX_API_KEY=377EB9E769AB4D0AAC13224A54B37946
COINEX_API_SECRET=83ADBF2285D42A626FB0612E0D020EBE1452236217992B53

# Trading Configuration
TRADING_MODE=NORMAL
TRADING_ENV=production
POSITION_SIZE_MODE=percentage
LEVERAGE=2.0

# AAVE-Specific Settings
DEFAULT_TRADING_MARKET=AAVEUSDT

# Database
DATABASE_PATH=./storage/bot_state_aave.db

# Logging
LOG_LEVEL=INFO
SHOW_DEBUG_INFO=False

# Container Settings
DOCKER_CONTAINER=true

# Trading Strategy Parameters
# AAVE typically trades at higher prices ($80-300) vs ADA ($0.30-0.80)
MIN_POSITION_SIZE=50.0    # Higher minimum for AAVE
MAX_POSITION_SIZE=500.0   # Adjusted for higher token price
MIN_PROFIT_PERCENT=1.5    # Slightly higher profit target
MAX_RANGE_DEVIATION=5.0

# Telegram Notifications (Optional)
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Risk Management
MAX_DAILY_ORDERS=20
EMERGENCY_STOP_LOSS_PERCENT=0  # No stop losses in this strategy

# API Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=10

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=20
ORDER_STATUS_CHECK_INTERVAL=-1