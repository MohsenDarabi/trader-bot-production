# VET Trading Bot Environment Configuration
# CoinEx API Credentials for VET Account (to be updated from VM)
COINEX_API_KEY=placeholder_vet_api_key
COINEX_API_SECRET=placeholder_vet_api_secret

# Trading Configuration
TRADING_MODE=NORMAL
POSITION_SIZE_MODE=percentage
LEVERAGE=2.0

# Default Trading Market
DEFAULT_TRADING_MARKET=VETUSDT

# Container Settings
DOCKER_CONTAINER=true